---
import { RESUME_URL, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const nav = [
	{ label: 'Home', href: '/', active: path === '/' },
	{ label: 'Projects', href: '/projects/', active: path.startsWith('/projects') },
	{ label: 'Blog', href: '/blog/', active: path.startsWith('/blog') },
	{ label: 'Resume', href: RESUME_URL, active: false },
];
---

<header class="site-header">
	<a class="site-name" href="/">{SITE_TITLE}</a>
	<nav aria-label="Main">
		{
			nav.map((item) => (
				<a href={item.href} aria-current={item.active ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
		<button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
				<circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
				<path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const media = window.matchMedia('(prefers-color-scheme: dark)');

	function current(): 'light' | 'dark' {
		const set = root.dataset.theme;
		if (set === 'light' || set === 'dark') return set;
		return media.matches ? 'dark' : 'light';
	}

	function sync(button: HTMLButtonElement) {
		const dark = current() === 'dark';
		button.setAttribute('aria-pressed', String(dark));
		button.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
	}

	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
		sync(button);
		media.addEventListener('change', () => sync(button));
		button.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {}
			sync(button);
		});
	});
</script>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 2rem 0;
	}
	.site-name {
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		font-size: 0.95rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--ink);
	}
	nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--rule-strong);
		text-underline-offset: 0.3em;
	}
	.theme-toggle {
		align-self: center;
		display: inline-grid;
		place-items: center;
		/* 44px tap target. Negative margins keep the 16px icon in the same spot. */
		width: 2.75rem;
		height: 2.75rem;
		margin: -0.875rem -0.875rem -0.875rem -0.625rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--ink);
	}
</style>
