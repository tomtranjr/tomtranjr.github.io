---
import { RESUME_URL, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const nav = [
	{ label: 'Home', href: '/', active: path === '/' },
	{ label: 'Projects', href: '/projects/', active: path.startsWith('/projects') },
	{ label: 'Resume', href: RESUME_URL, active: false },
];
---

<header class="site-header">
	<a class="site-name" href="/">{SITE_TITLE}</a>
	<nav aria-label="Main">
		{
			nav.map((item) => (
				<a href={item.href} aria-current={item.active ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 2rem 0;
	}
	.site-name {
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.95rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--ink);
	}
	nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--rule-strong);
		text-underline-offset: 0.3em;
	}
</style>
