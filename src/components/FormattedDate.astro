---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Frontmatter dates parse as UTC midnight. Format in UTC so the day does not shift.
			timeZone: 'UTC',
		})
	}
</time>
