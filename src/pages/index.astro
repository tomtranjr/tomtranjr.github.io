---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.png';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { EDUCATION, EXPERIENCE, LINKS, RESUME_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../utils/posts';

const recent = (await getCollection('projects'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const recentPosts = (await getPosts()).slice(0, 3);
---

<Base description={SITE_DESCRIPTION}>
	<section class="intro">
		<Image
			class="headshot"
			src={headshot}
			alt="Portrait of Tom Tran Jr"
			width={112}
			height={112}
			densities={[1, 2]}
			loading="eager"
		/>
		<div>
			<h1>{SITE_TITLE}</h1>
			<p class="role">
				Forward Deployed Engineer at <a href="https://arango.ai/">Arango</a>
			</p>
		</div>
	</section>

	<section class="prose">
		<p>
			I'm a Forward Deployed Engineer at <a href="https://arango.ai/">Arango</a>. I help teams in the federal and national security
			space build AI on their own data. My day-to-day is graph modeling, AQL traversals, and GraphRAG
			and vector search retrieval, tuned to each customer's environment.
		</p>
		<p>
			Before Arango, I built data pipelines at the U.S. Department of State. Seeing how much of that
			manual work an LLM could take over is what pulled me into AI.
		</p>
		<p>
			I also serve in the California Air National Guard's <a href="https://www.129rqw.ang.af.mil/"
				>129th Rescue Wing</a
			>, where I'm a founding member of its AI unit, the <a href="https://caaiu.org/"
				>California Artificial Intelligence Unit (CA AIU)</a
			>.
		</p>
		<p class="links">
			{LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href={RESUME_URL}>Resume</a>
		</p>
	</section>

	<section>
		<h2>Experience</h2>
		<ul class="rows">
			{
				EXPERIENCE.map((item) => (
					<li>
						<span>
							{item.role}, <span class="muted">{item.org}</span>
						</span>
						<span class="muted when">{item.years}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>Education</h2>
		<ul class="rows">
			{
				EDUCATION.map((item) => (
					<li>
						<span>
							{item.degree}, <span class="muted">{item.school}</span>
						</span>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>Recent projects</h2>
		<ProjectList projects={recent} />
		<p class="more"><a href="/projects/">All projects</a></p>
	</section>

	{
		recentPosts.length > 0 && (
			<section>
				<h2>Recent posts</h2>
				<PostList posts={recentPosts} />
				<p class="more">
					<a href="/blog/">All posts</a>
				</p>
			</section>
		)
	}
</Base>

<style>
	.intro {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding-block: 3.5rem 2rem;
	}
	.headshot {
		flex: none;
		width: 112px;
		height: 112px;
		border-radius: 50%;
		object-fit: cover;
	}
	h1 {
		margin: 0;
	}
	.role {
		margin: 0.35rem 0 0;
		color: var(--muted);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}
	section + section {
		margin-top: 3rem;
	}
	.rows {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.4rem;
	}
	.muted {
		color: var(--muted);
	}
	.when {
		flex: none;
		font-variant-numeric: tabular-nums;
	}
	.more {
		margin-top: 1rem;
		font-size: 0.95rem;
	}
	@media (max-width: 480px) {
		.intro {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
		.rows li {
			flex-direction: column;
			gap: 0;
		}
	}
</style>
