---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroAlt, draft } = Astro.props;
---

<Base title={title} description={description} image={heroImage}>
	<article class="post">
		<p class="back"><a href="/blog/">Blog</a></p>
		<h1>{title}</h1>
		<p class="meta">
			<FormattedDate date={pubDate} />
			{
				updatedDate && (
					<span>
						Updated <FormattedDate date={updatedDate} />
					</span>
				)
			}
			{draft && <span>Draft</span>}
		</p>
		{
			heroImage && (
				<figure class="hero">
					<Image src={heroImage} alt={heroAlt ?? ''} width={720} densities={[1, 2]} />
				</figure>
			)
		}
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<style>
	.post {
		padding-top: 3.5rem;
	}
	.back {
		margin: 0 0 1.5rem;
		font-size: 0.9rem;
	}
	.back a {
		color: var(--muted);
		text-decoration: none;
	}
	.back a::before {
		content: '\2190\00a0';
	}
	.back a:hover {
		color: var(--ink);
	}
	h1 {
		margin: 0;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0.75rem 0 2.5rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.hero {
		margin: 0 0 2.5rem;
	}
	.hero img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--rule);
		border-radius: 4px;
	}
</style>
